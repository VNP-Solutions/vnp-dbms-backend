datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectType {
  DBMS
  DASHBOARD
  PARSER
}

enum InvitationRoleEnum {
  admin
  partial
}

enum InvitationStatus {
  Pending
  Accepted
  Expired
  Cancelled
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  ACCOUNT_VERIFICATION
  MFA_SETUP
}

enum PermissionLevel {
  all
  update
  view
}

enum AccessLevel {
  all
  partial
  none
}



model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  first_name         String
  last_name          String
  email              String    @unique
  language           String
  user_role_id       String    @db.ObjectId
  role               UserRole  @relation(fields: [user_role_id], references: [id])
  password           String
  display_image      String?
  contact_number     String?
  job_title          String?
  phone_number       String?
  is_verified        Boolean   @default(false)
  temp_password      String?
  invitation_sent_at DateTime?
  invited_by_id      String?   @db.ObjectId
  invitedBy          User?     @relation("UserInvitedBy", fields: [invited_by_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitedUsers       User[]    @relation("UserInvitedBy")

  otps                         Otp[]
  userAccessedProperties       UserAccessedProperty[]
  userFeatureAccessPermissions UserFeatureAccessPermission[]
  sentInvitations              UserInvitation[]              @relation("InvitedBy")
  receivedInvitations          UserInvitation[]              @relation("InvitedUser")
  userProjectRoles             UserProjectRole[]
  uploadedFiles                File[]
  column_templates             ColumnTemplate[]
  notes                        Note[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_role_id])
  @@index([is_verified])
  @@index([invited_by_id])
}

model Otp {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  user_id    String     @db.ObjectId
  otp_code   String
  purpose    OtpPurpose @default(LOGIN)
  ip_address String?
  expires_at DateTime
  is_used    Boolean    @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([otp_code])
  @@index([purpose])
  @@index([ip_address])
  @@index([expires_at])
  @@index([is_used])
}

model UserInvitation {
  id               String                  @id @default(auto()) @map("_id") @db.ObjectId
  email            String
  invited_by_id    String                  @db.ObjectId
  invited_user_id  String?                 @db.ObjectId
  user_role_id     String                  @db.ObjectId
  invitation_token String                  @unique
  role             InvitationRoleEnum      @default(partial)
  status           InvitationStatus        @default(Pending)
  expires_at       DateTime
  accepted_at      DateTime?
  message          String?
  portfolio_ids    String[]                @default([]) @db.ObjectId
  subportfolio_ids String[]                @default([]) @db.ObjectId
  property_ids     String[]                @default([]) @db.ObjectId
  project_roles    ProjectRoleInvitation[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  invitedBy   User     @relation("InvitedBy", fields: [invited_by_id], references: [id], onDelete: Cascade)
  invitedUser User?    @relation("InvitedUser", fields: [invited_user_id], references: [id], onDelete: SetNull)
  userRole    UserRole @relation(fields: [user_role_id], references: [id])

  @@unique([email, status], name: "unique_pending_invitation")
  @@index([email])
  @@index([status])
  @@index([invited_by_id])
  @@index([invited_user_id])
  @@index([user_role_id])
}

type ProjectRoleInvitation {
  project_type     ProjectType
  user_role_id     String      @db.ObjectId
  portfolio_ids    String[]    @default([]) @db.ObjectId
  subportfolio_ids String[]    @default([]) @db.ObjectId
  property_ids     String[]    @default([]) @db.ObjectId
}

model UserRole {
  id                         String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                       String                    @unique
  description                String
  is_external                Boolean
  can_access_mis             Boolean                   @default(false)
  is_active                  Boolean                   @default(true)
  order                      Int                       @default(0)
  portfolio_permission       PortfolioPermission?
  property_permission        PropertyPermission?
  audit_permission           AuditPermission?
  user_permission            UserPermission?
  system_settings_permission SystemSettingsPermission?
  bank_details_permission    BankDetailsPermission?
  roles_permission           RolesPermission?
  access_logs_permission     AccessLogsPermission?
  users                      User[]
  invitations                UserInvitation[]
  projectRoles               ProjectRole[]
  userProjectRoles           UserProjectRole[]
  user_column_template_id    String?                   @db.ObjectId
  user_column_template       ColumnTemplate?           @relation(fields: [user_column_template_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([is_active])
  @@index([is_external])
  @@index([order])
  @@index([user_column_template_id])
}

type PortfolioPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type PropertyPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type AuditPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type UserPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type SystemSettingsPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type BankDetailsPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type RolesPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

type AccessLogsPermission {
  permission_level PermissionLevel
  access_level     AccessLevel
}

model File {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  url          String
  name         String
  description  String?
  is_active    Boolean    @default(true)
  uploaded_by  String     @db.ObjectId
  uploadedBy   User       @relation(fields: [uploaded_by], references: [id])
  portfolio_id String?    @db.ObjectId
  portfolio    Portfolio? @relation(fields: [portfolio_id], references: [id])
  created_at   DateTime   @default(now())
  updated_at   DateTime   @updatedAt

  @@index([portfolio_id])
  @@index([uploaded_by])
}

model UserAccessedProperty {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  user_id      String   @db.ObjectId
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  portfolio_id String[] @db.ObjectId
  property_id  String[] @db.ObjectId

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
}

model ServiceType {
  id         String      @id @default(auto()) @map("_id") @db.ObjectId
  type       String      @unique
  is_active  Boolean
  order      Int         @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Back-relations
  portfolios                Portfolio[]
  properties                Property[]  @relation("PropertyServiceType")
  expedia_properties        Property[]  @relation("PropertyExpediaServiceType")
  booking_properties        Property[]  @relation("PropertyBookingServiceType")
  agoda_properties          Property[]  @relation("PropertyAgodaServiceType")

  @@index([is_active])
  @@index([order])
}

model Currency {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String  @unique
  name      String
  symbol    String?
  is_active Boolean @default(true)
  order     Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  properties Property[]  @relation("PropertyCurrency")
  portfolios Portfolio[] @relation("PortfolioCurrency")

  @@index([is_active])
  @@index([order])
}

model Portfolio {
  id                           String                        @id @default(auto()) @map("_id") @db.ObjectId
  name                         String                        @unique
  service_type_id              String?                       @db.ObjectId
  service_type                 ServiceType?                  @relation(fields: [service_type_id], references: [id])
  currency_id                  String?                       @db.ObjectId
  currency                     Currency?                     @relation("PortfolioCurrency", fields: [currency_id], references: [id])
  is_active                    Boolean
  contact_email                String?
  portfolio_contact_email      String?
  portfolio_contact_name       String?
  portfolio_contact_phone      String?
  is_commissionable            Boolean
  commission                   Float?
  attachment                   String?
  attachments                  String[]                      @default([])
  contract_urls                File[]
  contract_signed              Boolean?
  subportfolios                Subportfolio[]
  properties                   Property[]
  userFeatureAccessPermissions UserFeatureAccessPermission[]
  notes                        Note[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([service_type_id])
  @@index([currency_id])
  @@index([is_active])
  @@index([is_commissionable])
}

model Subportfolio {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  name         String    @unique
  description  String?
  portfolio_id String    @db.ObjectId
  portfolio    Portfolio @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  properties                   Property[]
  userFeatureAccessPermissions UserFeatureAccessPermission[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([portfolio_id])
}

model Property {
  id                    String        @id @default(auto()) @map("_id") @db.ObjectId
  name                  String        @unique
  card_descriptor       String?
  is_active             Boolean       @default(true)
  next_due_date         DateTime?
  portfolio_id          String        @db.ObjectId
  portfolio             Portfolio     @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)

  // Service Type
  service_type_id       String?       @db.ObjectId
  service_type          ServiceType?  @relation("PropertyServiceType", fields: [service_type_id], references: [id])

  currency_id           String?       @db.ObjectId
  currency              Currency?     @relation("PropertyCurrency", fields: [currency_id], references: [id])
  priority_id           String?       @db.ObjectId
  priority              Priority?     @relation("PropertyPriority", fields: [priority_id], references: [id])
  subportfolio_id       String?       @db.ObjectId
  subportfolio          Subportfolio? @relation(fields: [subportfolio_id], references: [id], onDelete: SetNull)
  previous_portfolio_id String?       @db.ObjectId
  show_in_portfolio     String[]      @default([]) @db.ObjectId

  new_domain_email        String?
  others_case_emails      String[] @default([])
  primary_case_email      String?
  portfolio_contact_email String?
  portfolio_contact       String?
  webmail_password        String?
  description             String?
  hotel_address           String?
  property_identifier     String?

  // Contact Information
  case_management_contact String?
  access_contact          String?
  reporting_contact       String?

  // OTA Processors
  expedia_processor_id  String?    @db.ObjectId
  expedia_processor     Processor? @relation("PropertyExpediaProcessor", fields: [expedia_processor_id], references: [id])
  booking_processor_id  String?    @db.ObjectId
  booking_processor     Processor? @relation("PropertyBookingProcessor", fields: [booking_processor_id], references: [id])
  agoda_processor_id    String?    @db.ObjectId
  agoda_processor       Processor? @relation("PropertyAgodaProcessor", fields: [agoda_processor_id], references: [id])

  // Date Range Fields (legacy)
  from String?
  to   String?

  // QP / FP Credentials (passwords encrypted at application layer)
  qp_username          String?
  qp_password          String?
  qp_api_key           String?
  fp_mid               String?
  fp_username          String?
  fp_password          String?
  stripe_account_email String?

  // OTA Integration Fields
  expedia_id     Int?
  expedia_status String?
  booking_id     Int?
  booking_status String?
  agoda_id       Int?
  agoda_status   String?

  // Expedia integration detail
  expedia_billing_type_id   String?      @db.ObjectId
  expedia_billing_type      BillingType? @relation("PropertyExpediaBillingType", fields: [expedia_billing_type_id], references: [id])
  expedia_service_type_id   String?      @db.ObjectId
  expedia_service_type      ServiceType? @relation("PropertyExpediaServiceType", fields: [expedia_service_type_id], references: [id])
  expedia_frequency_id      String?      @db.ObjectId
  expedia_frequency         Frequency?   @relation("PropertyExpediaFrequency", fields: [expedia_frequency_id], references: [id])
  expedia_access_level      Boolean?
  expedia_from              String?
  expedia_to                String?
  expedia_scheduler         Boolean?
  expedia_duration          Int?
  expedia_service_fee       Int?
  expedia_crs               String?
  expedia_crs_db            String?
  expedia_run_date_from        String?
  expedia_run_date_to          String?
  expedia_run_date_db_from     String?
  expedia_run_date_db_to       String?
  expedia_revised_date         String?
  expedia_scheduler_review_from    String?
  expedia_scheduler_review_to      String?
  expedia_scheduler_db              String?
  expedia_scheduler_review_db_from String?
  expedia_scheduler_review_db_to   String?
  expedia_db_duration         Int?
  expedia_credential_verified Boolean?
  expedia_otp_number          String?
  from_db                     String?
  to_db                       String?

  // Booking.com integration detail
  booking_billing_type_id   String?      @db.ObjectId
  booking_billing_type      BillingType? @relation("PropertyBookingBillingType", fields: [booking_billing_type_id], references: [id])
  booking_service_type_id   String?      @db.ObjectId
  booking_service_type      ServiceType? @relation("PropertyBookingServiceType", fields: [booking_service_type_id], references: [id])
  booking_frequency_id      String?      @db.ObjectId
  booking_frequency         Frequency?   @relation("PropertyBookingFrequency", fields: [booking_frequency_id], references: [id])
  booking_access_level      Boolean?
  booking_from              String?
  booking_to                String?
  booking_scheduler         Boolean?
  booking_duration          Int?
  booking_service_fee       Int?
  booking_crs               String?
  booking_run_date_from     String?
  booking_run_date_to       String?
  booking_revised_date      String?
  booking_credential_verified Boolean?
  booking_otp_number          String?

  // Agoda integration detail
  agoda_billing_type_id   String?      @db.ObjectId
  agoda_billing_type      BillingType? @relation("PropertyAgodaBillingType", fields: [agoda_billing_type_id], references: [id])
  agoda_service_type_id   String?      @db.ObjectId
  agoda_service_type      ServiceType? @relation("PropertyAgodaServiceType", fields: [agoda_service_type_id], references: [id])
  agoda_frequency_id      String?      @db.ObjectId
  agoda_frequency         Frequency?   @relation("PropertyAgodaFrequency", fields: [agoda_frequency_id], references: [id])
  agoda_access_level      Boolean?
  agoda_from              String?
  agoda_to                String?
  agoda_scheduler         Boolean?
  agoda_duration          Int?
  agoda_service_fee       Int?
  agoda_crs               String?
  agoda_run_date_from     String?
  agoda_run_date_to       String?
  agoda_revised_date      String?
  agoda_credential_verified Boolean?
  agoda_otp_number          String?

  sales_rep   String?

  // Payment gateway fields
  discontinued_email_ids String[] @default([])
  cybersource_mid        String?
  adyen_location         String?
  stripe_connected_email String?

  // OTA Configuration
  need_another_domain Boolean?
  booking_otp_phone   String?

  userFeatureAccessPermissions UserFeatureAccessPermission[]
  credentials                  PropertyCredentials[]
  notes                        Note[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([portfolio_id])
  @@index([subportfolio_id])
  @@index([service_type_id])
  @@index([currency_id])
  @@index([priority_id])
  @@index([is_active])
  @@index([next_due_date])
  @@index([portfolio_id, is_active])
  @@index([expedia_id])
  @@index([booking_id])
  @@index([agoda_id])
}

model UserFeatureAccessPermission {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  user_id         String  @db.ObjectId
  portfolio_id    String? @db.ObjectId
  subportfolio_id String? @db.ObjectId
  property_id     String? @db.ObjectId

  user         User?         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  portfolio    Portfolio?    @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  subportfolio Subportfolio? @relation(fields: [subportfolio_id], references: [id], onDelete: Cascade)
  property     Property?     @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([portfolio_id])
  @@index([subportfolio_id])
  @@index([property_id])
}

model ProjectRole {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  project_type       ProjectType
  name               String
  description        String?
  base_user_role_id  String            @db.ObjectId
  base_user_role     UserRole          @relation(fields: [base_user_role_id], references: [id])
  is_active          Boolean           @default(true)
  user_project_roles UserProjectRole[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([project_type, name])
  @@index([project_type])
  @@index([is_active])
  @@index([base_user_role_id])
}

model UserProjectRole {
  id               String      @id @default(auto()) @map("_id") @db.ObjectId
  user_id          String      @db.ObjectId
  project_role_id  String      @db.ObjectId
  project_type     ProjectType
  user_role_id     String      @db.ObjectId
  portfolio_ids    String[]    @default([]) @db.ObjectId
  subportfolio_ids String[]    @default([]) @db.ObjectId
  property_ids     String[]    @default([]) @db.ObjectId
  is_active        Boolean     @default(true)

  user         User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project_role ProjectRole @relation(fields: [project_role_id], references: [id], onDelete: Cascade)
  user_role    UserRole    @relation(fields: [user_role_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([user_id, project_type])
  @@index([user_id])
  @@index([project_role_id])
  @@index([project_type])
  @@index([user_role_id])
  @@index([is_active])
  @@index([user_id, project_type, is_active])
}

model PropertyCredentials {
  id                       String   @id @default(auto()) @map("_id") @db.ObjectId
  property_id              String   @db.ObjectId
  expediaUsername          String?
  expediaPassword          String?
  agodaUsername            String?
  agodaPassword            String?
  bookingUsername          String?
  bookingPassword          String?
  expediaSecondaryUsername String?
  expediaSecondaryPassword String?
  bookingSecondaryUsername String?
  bookingSecondaryPassword String?
  agodaSecondaryUsername   String?
  agodaSecondaryPassword   String?
  expediaEmailAssociated   String?
  propertyContactEmail     String?
  portfolioContactEmail    String?
  multiplePortfolioEmails  String[] @default([])

  case_contact_email String?
  case_contact_name  String?
  case_contact_phone String?

  reporting_contact_name  String?
  reporting_contact_email String?
  reporting_contact_phone String?

  property Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([property_id])
}

model BillingType {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  is_active  Boolean  @default(true)
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Back-relations
  expedia_properties  Property[] @relation("PropertyExpediaBillingType")
  booking_properties  Property[] @relation("PropertyBookingBillingType")
  agoda_properties    Property[] @relation("PropertyAgodaBillingType")

  @@index([is_active])
  @@index([order])
}

model Priority {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  is_active  Boolean  @default(true)
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Back-relations
  properties Property[] @relation("PropertyPriority")

  @@index([is_active])
  @@index([order])
}

model Frequency {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  is_active  Boolean  @default(true)
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Back-relations
  expedia_properties  Property[] @relation("PropertyExpediaFrequency")
  booking_properties  Property[] @relation("PropertyBookingFrequency")
  agoda_properties    Property[] @relation("PropertyAgodaFrequency")

  @@index([is_active])
  @@index([order])
}

model Processor {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String   @unique
  is_active  Boolean  @default(true)
  order      Int      @default(1)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Back-relations
  expedia_properties  Property[] @relation("PropertyExpediaProcessor")
  booking_properties  Property[] @relation("PropertyBookingProcessor")
  agoda_properties    Property[] @relation("PropertyAgodaProcessor")

  @@index([is_active])
  @@index([order])
}

model NotificationEmail {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ActivityLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String
  role         String
  roleId       String?
  endpoint     String
  success      Boolean
  statusCode   Int
  ipAddress    String
  location     String?
  timezone     String?
  resource     String
  responseTime Int
  timestamp    DateTime @default(now())

  @@map("activity_logs")
}

// ─── OTP Status ───────────────────────────────────────────────────────────────

enum OtpPlatform {
  expedia
  agoda
  booking
  expedia_retrieval
  agoda_retrieval
}

enum OtpStatusValue {
  Released
  Occupied
}

model OtpStatus {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  status     OtpStatusValue @default(Released)
  platform   OtpPlatform
  job_id     String?        @db.ObjectId
  created_at DateTime?      @default(now())
  updated_at DateTime?      @updatedAt

  @@unique([platform])
  @@map("otp_statuses")
}

model ColumnTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  column_list String[]
  user_id     String   @db.ObjectId
  user        User     @relation(fields: [user_id], references: [id])
  roles       UserRole[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@map("UserColumnTemplate")
}

model Note {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  text         String
  is_done      Boolean    @default(false)
  user_id      String     @db.ObjectId
  user         User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  portfolio_id String?    @db.ObjectId
  portfolio    Portfolio? @relation(fields: [portfolio_id], references: [id], onDelete: Cascade)
  property_id  String?    @db.ObjectId
  property     Property?  @relation(fields: [property_id], references: [id], onDelete: Cascade)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id])
  @@index([portfolio_id])
  @@index([property_id])
}
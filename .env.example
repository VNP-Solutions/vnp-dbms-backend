# =============================================================================
# VNP DBMS Backend — local development (no Docker)
# =============================================================================
# Swagger: http://localhost:8080/api/docs
# API base: http://localhost:8080/api
# =============================================================================

NODE_ENV=development
PORT=8080
APP_NAME='VNP DBMS Backend'

# Database (Atlas or local MongoDB)
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority&appName=VnpParser&tlsAllowInvalidCertificates=true

# User auth JWT (DBMS app only)
JWT_ACCESS_SECRET=<jwt-access-secret>
JWT_REFRESH_SECRET=<jwt-refresh-secret>
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=14d

# Cross-backend sync auth (DBMS → Dashboard / Scraper portfolio sync)
# MUST be identical on DBMS, Dashboard, and Scraper.
JWT_COMMUNICATION_SECRET=local-dev-communication-secret-change-me
JWT_COMMUNICATION_TOKEN_EXPIRES_IN=1d

# Where DBMS fans out portfolio/property sync (base URL only — no trailing slash)
# Dashboard routes use /api/... ; Scraper routes have no /api prefix.
DASHBOARD_BACKEND_URL=http://localhost:5001
SCRAPER_BACKEND_URL=http://localhost:8081
SYNC_TIMEOUT_MS=15000
# This DBMS backend's own reachable URL (used to build the sync-callback URL
# that dashboard/scraper POST their async bulk-upsert results back to).
PUBLIC_API_URL=http://localhost:3000
# Stale sync batch threshold (ms) — batches older than this without all
# callbacks are finalized by the sweeper with missing sources marked failed.
SYNC_BATCH_STALE_MS=600000

# Legacy X-Service-Token (property sync only — portfolio create uses JWT above)
# Set the same value as SERVICE_TOKEN on the target backend.
SERVICE_TOKEN=local-dev-service-token-change-me
DASHBOARD_SERVICE_TOKEN=local-dev-service-token-change-me
SCRAPER_SERVICE_TOKEN=local-dev-service-token-change-me

# CORS for DBMS frontend (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# AWS S3
S3_BUCKET_NAME=<s3-bucket-name>
S3_REGION=<s3-region>
S3_ACCESS_KEY=<s3-access-key>
S3_SECRET_KEY=<s3-secret-key>
S3_BUCKET_URL=<s3-bucket-url>

# Google OAuth (Gmail API — shared token key across all systems)
# Must match an Authorized redirect URI in Google Cloud Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://dbms.dashboardvnps.com/dashboard/dbms
GOOGLE_TOKEN_S3_KEY=google-oauth/token.json

# SMTP
SMTP_EMAIL=<smtp-email>
SMTP_PASSWORD=<smtp-password>

INVITATION_REDIRECT_URL=http://localhost:3000
DASHBOARD_URL=http://localhost:3000

PARALLEL_WORKERS=8

# Super Admin Bootstrap
SUPER_ADMIN_SECRET=<super-admin-secret>

# Optional — Expedia checker / queue (leave empty if unused locally)
EXPEDIA_CHECKER_BASE_URL=
EXPEDIA_CHECKER_TIMEOUT_MS=30000
EXPEDIA_CHECK_QUEUE_URL=
EXPEDIA_CHECK_LAMBDA_FUNCTION_NAME=
EXPEDIA_CHECK_LAMBDA_PLATFORM=expedia

NODE_ENV=development
PORT=8080
APP_NAME='App Name'

# Database
DATABASE_URL=mongodb+srv://username:password@your-mongodb-app.mongodb.net/db-name?retryWrites=true&w=majority&appName=AppName

#JWT
JWT_ACCESS_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_ACCESS_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=14d

# CORS / Cookies (HTTP-only auth)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000
COOKIE_ACCESS_TOKEN_NAME=accessToken
COOKIE_REFRESH_TOKEN_NAME=refreshToken
# COOKIE_DOMAIN=.yourdomain.com
COOKIE_PATH=/
# COOKIE_SECURE=false
# COOKIE_SAME_SITE=lax
# Short session when keep_sign_in=false on login (defaults: 2h access, 18h refresh)
# COOKIE_SESSION_ACCESS_MAX_AGE_MS=7200000
# COOKIE_SESSION_REFRESH_MAX_AGE_MS=64800000
# COOKIE_SESSION_ACCESS_EXPIRES_IN=2h
# COOKIE_SESSION_REFRESH_EXPIRES_IN=18h

#AWS S3 bucket
S3_BUCKET_NAME=bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_URL=https://app-name.s3.us-east-1.amazonaws.com/bucket-name

# SMTP
SMTP_EMAIL=exmaple@email.com
SMTP_PASSWORD=xxxxxxxxxxxxxx

INVITATION_REDIRECT_URL=https://www.your-redirect-url.com

PARALLEL_WORKERS=8

SUPER_ADMIN_SECRET=your-super-admin-secret

# Scraper Backend (vnp-scraper-backend)
SCRAPER_BACKEND_URL=http://localhost:3001   # Base URL of the scraper backend

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=                      # Optional: leave blank for no auth (local dev)
REDIS_TTL=                           # Default cache TTL in seconds (300 = 5 minutes)